rules_version = '2';

// Firestore 보안 규칙 — Firebase 콘솔 → Firestore Database → 규칙 탭에 그대로 붙여넣고 "게시"를 눌러요.
// 관리자 UID는 이미 들어가 있어요 (Authentication → 사용자 목록의 "사용자 UID"). 계정을 바꾸면 이 값도 바꿔요.
// 이유: 웹 설정값(apiKey)은 공개라서, 누구나 Firebase에 새 계정을 만들 수는 있어요.
//       그래서 "로그인했는가"가 아니라 "이 UID인가"로 관리자를 가려요.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == "MSBbFHuHxmUeHxF1UJ687xZsXeF3";
    }

    function validPost() {
      let p = request.resource.data;
      return p.title is string && p.title.size() > 0 && p.title.size() <= 200
        && p.body is string && p.body.size() <= 100000
        && (!("contentHtml" in p) || (p.contentHtml is string && p.contentHtml.size() <= 400000))
        && p.status in ["draft", "published", "private"]
        && p.authorUid == request.auth.uid;
    }

    // 글: 발행된 글은 누구나, 임시저장·비공개 글은 관리자만 읽어요
    match /posts/{postId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update: if isAdmin() && validPost();
      allow delete: if isAdmin();
    }

    // 사진: 글에 들어간 사진 (줄인 JPEG을 글자로 저장). 누구나 보고, 관리자만 올리고 지워요
    match /images/{imageId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 950000
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // 좋아요 수 (PRD FR-04): 누구나 읽고, 로그인 없이 ±1만 바꿀 수 있어요.
    // - 처음 만들 때는 likeCount = 1만, 발행된 글에만
    // - 바꿀 때는 likeCount 하나만, 이전 값에서 +1 또는 -1, 0 미만 불가
    // - 지우기는 관리자만
    match /postStats/{postId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(["likeCount"])
        && request.resource.data.likeCount == 1
        && exists(/databases/$(database)/documents/posts/$(postId))
        && get(/databases/$(database)/documents/posts/$(postId)).data.status == "published";
      allow update: if request.resource.data.keys().hasOnly(["likeCount"])
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && (request.resource.data.likeCount == resource.data.likeCount + 1
            || request.resource.data.likeCount == resource.data.likeCount - 1);
      allow delete: if isAdmin();
    }

    // 작업 · 케이스 스터디 (PRD v1.1 F3 · F4 · F6): 게시된 작업은 누구나, 초안은 관리자만 읽어요.
    // 방문자에게 보이면 안 되는 메모 · 비공개 클라이언트 이름은 workNotes(관리자 전용)에 따로 둬요.
    match /works/{workId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update: if isAdmin() && validWork();
      allow delete: if isAdmin();
    }
    match /workNotes/{workId} {
      allow read, write: if isAdmin();
    }

    function validWork() {
      let w = request.resource.data;
      return w.keys().hasOnly(["name", "title", "summary", "problem", "process", "result", "tags", "category", "industry", "period", "client", "coverImageId", "imageIds", "status", "createdAt", "updatedAt", "publishedAt", "authorUid", "role", "imageSizes"])
        && (!("imageSizes" in w) || (w.imageSizes is list && w.imageSizes.size() <= 4))
        && (!("role" in w) || (w.role is string && w.role.size() <= 60))
        && w.name is string && w.name.size() > 0 && w.name.size() <= 60
        && w.title is string && w.title.size() <= 100
        && w.summary is string && w.summary.size() <= 200
        && w.problem is string && w.problem.size() <= 3000
        && w.process is string && w.process.size() <= 5000
        && w.result is string && w.result.size() <= 3000
        && w.tags is list && w.tags.size() <= 8
        && w.status in ["draft", "published"]
        && (w.status == "draft" || (w.title.size() > 0 && w.summary.size() > 0 && w.problem.size() > 0 && w.process.size() > 0 && w.result.size() > 0))
        && w.authorUid == request.auth.uid;
    }

    // 의뢰 (v0.2 의뢰 저장 기능): 방문자는 만들기만, 읽기 · 수정 · 삭제는 관리자만.
    // 이름 · 이메일이 들어 있는 개인정보라 방문자 읽기는 절대 열지 않아요.
    // AI 분석 결과(ai) · 상태 변경(status)은 관리자만 update로 붙여요.
    match /requests/{requestId} {
      allow create: if validNewRequest();
      allow read, update, delete: if isAdmin();
    }

    function validNewRequest() {
      let r = request.resource.data;
      let fields = ["name", "email", "categories", "budget", "content", "status", "createdAt"];
      // F2 의뢰서 (PRD v1.2): 희망 일정 · 레퍼런스 작업 · 레퍼런스 링크는 선택
      let optional = ["schedule", "refWorks", "refLinks"];
      return r.keys().hasOnly(fields.concat(optional)) && r.keys().hasAll(fields)
        && (!("schedule" in r) || (r.schedule is string && r.schedule.size() <= 50))
        && (!("refWorks" in r) || (r.refWorks is list && r.refWorks.size() <= 5))
        && (!("refLinks" in r) || (r.refLinks is list && r.refLinks.size() <= 3))
        && r.name is string && r.name.size() > 0 && r.name.size() <= 50
        && r.email is string && r.email.size() <= 100
        && r.email.matches("^[^@\\s]+@[^@\\s]+[.][^@\\s]+$")
        && r.categories is list && r.categories.size() <= 4
        && r.categories.hasOnly(["브랜딩", "UI/UX 디자인", "콘텐츠 제작", "기타"])
        && r.budget is string && r.budget.size() <= 50
        && r.content is string && r.content.size() >= 5 && r.content.size() <= 3000
        && r.status == "new"
        && r.createdAt == request.time;
    }
  }
}
