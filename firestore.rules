rules_version = '2';

// Firestore 보안 규칙 — Firebase 콘솔 → Firestore Database → 규칙 탭에 그대로 붙여넣고 "게시"를 눌러요.
// 관리자 UID는 이미 들어가 있어요 (Authentication → 사용자 목록의 "사용자 UID"). 계정을 바꾸면 이 값도 바꿔요.
// 이유: 웹 설정값(apiKey)은 공개라서, 누구나 Firebase에 새 계정을 만들 수는 있어요.
//       그래서 "로그인했는가"가 아니라 "이 UID인가"로 관리자를 가려요.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == "MSBbFHuHxmUeHxF1UJ687xZsXeF3";
    }

    function validPost() {
      let p = request.resource.data;
      return p.title is string && p.title.size() > 0 && p.title.size() <= 200
        && p.body is string && p.body.size() <= 100000
        && (!("contentHtml" in p) || (p.contentHtml is string && p.contentHtml.size() <= 400000))
        && p.status in ["draft", "published", "private"]
        && p.authorUid == request.auth.uid;
    }

    // 글: 발행된 글은 누구나, 임시저장·비공개 글은 관리자만 읽어요
    match /posts/{postId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update: if isAdmin() && validPost();
      allow delete: if isAdmin();

      // 댓글 (PRD FR-06, 관리자 승인제)
      // - 방문자는 승인된 댓글만 읽어요 (목록은 where status == "approved"로 불러야 해요)
      // - 등록: 발행된 글에, status "pending"으로만, 정해진 칸만, 길이 조건, 서버 시간, 미끼 칸은 비어 있어야, 링크 금지
      // - 승인 · 숨김 · 삭제는 관리자만
      match /comments/{commentId} {
        allow read: if resource.data.status == "approved" || isAdmin();
        allow create: if request.resource.data.keys().hasOnly(["nickname", "body", "createdAt", "status", "website"])
          && request.resource.data.status == "pending"
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() >= 2 && request.resource.data.nickname.size() <= 20
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 500
          && !request.resource.data.body.lower().matches("(?s).*(https?://|www[.]|[a-z0-9-][.](com|net|org|kr|io|me|xyz|ly)([^a-z]|$)).*")
          && !request.resource.data.nickname.lower().matches(".*(https?://|www[.]).*")
          && request.resource.data.website == ""
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/posts/$(postId)).data.status == "published";
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
          && request.resource.data.status in ["pending", "approved", "hidden"];
        allow delete: if isAdmin();
      }
    }

    // 사진: 글에 들어간 사진 (줄인 JPEG을 글자로 저장). 누구나 보고, 관리자만 올리고 지워요
    match /images/{imageId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 950000
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // 좋아요 수 (PRD FR-04): 누구나 읽고, 로그인 없이 ±1만 바꿀 수 있어요.
    // - 처음 만들 때는 likeCount = 1만, 발행된 글에만
    // - 바꿀 때는 likeCount 하나만, 이전 값에서 +1 또는 -1, 0 미만 불가
    // - 지우기는 관리자만
    match /postStats/{postId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(["likeCount"])
        && request.resource.data.likeCount == 1
        && exists(/databases/$(database)/documents/posts/$(postId))
        && get(/databases/$(database)/documents/posts/$(postId)).data.status == "published";
      allow update: if request.resource.data.keys().hasOnly(["likeCount"])
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && (request.resource.data.likeCount == resource.data.likeCount + 1
            || request.resource.data.likeCount == resource.data.likeCount - 1);
      allow delete: if isAdmin();
    }
  }
}
