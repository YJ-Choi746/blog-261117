{
  "hosting": [
    {
      "public": ".",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        "**/.*",
        "**/node_modules/**",
        "docs/**",
        "**/*.md",
        "functions/**",
        "tests/**"
      ],
      "cleanUrls": false,
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=300"
            }
          ]
        }
      ],
      "site": "jae-design"
    },
    {
